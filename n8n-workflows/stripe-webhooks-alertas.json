{
  "name": "Stripe Webhooks - Alertas",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-stripe",
      "name": "Webhook Stripe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "stripe-events-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-payment-failed",
              "leftValue": "={{ $json.type }}",
              "rightValue": "invoice.payment_failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-payment-failed",
      "name": "IF Pagamento Falhou",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-checkout",
              "leftValue": "={{ $json.type }}",
              "rightValue": "checkout.session.completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-checkout-completed",
      "name": "IF Compra Realizada",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "5263904952",
        "text": "=🚨 **ALERTA: Pagamento Falhou!**\n\n📧 Cliente: {{ $json.data.object.customer_email }}\n💰 Valor: R$ {{ $json.data.object.amount_due / 100 }}\n📅 Data: {{ $now.format('dd/MM/yyyy HH:mm') }}\n\n⚠️ Verificar e entrar em contato!",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-alert-failed",
      "name": "Telegram - Pagamento Falhou",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_CREDENTIAL",
          "name": "Telegram ElectroHub"
        }
      }
    },
    {
      "parameters": {
        "chatId": "5263904952",
        "text": "=✅ **Nova Venda!**\n\n💰 Valor: R$ {{ $json.data.object.amount_total / 100 }}\n📧 Cliente: {{ $json.data.object.customer_email }}\n🎁 Créditos: {{ $json.data.object.metadata.credits_amount }}\n📅 {{ $now.format('dd/MM/yyyy HH:mm') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-alert-sale",
      "name": "Telegram - Nova Venda",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_CREDENTIAL",
          "name": "Telegram ElectroHub"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        100
      ]
    }
