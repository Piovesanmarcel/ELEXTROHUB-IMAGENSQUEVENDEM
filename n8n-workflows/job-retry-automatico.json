{
    "name": "Job Retry Automático",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutesInterval": 10
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "A cada 10 minutos",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://bpqtzydsxmjazdzzcvno.supabase.co/rest/v1/rpc/get_failed_jobs",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
                        },
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "max_retry_count",
                            "value": "3"
                        },
                        {
                            "name": "limit_count",
                            "value": "10"
                        }
                    ]
                },
                "options": {}
            },
            "id": "get-failed-jobs",
            "name": "Buscar Jobs Falhados",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                220,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "has-jobs",
                            "leftValue": "={{ $json.length }}",
                            "rightValue": 0,
                            "operator": {
                                "type": "number",
                                "operation": "gt"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "if-has-jobs",
            "name": "Tem jobs para retry?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "batchSize": 1,
                "options": {}
            },
            "id": "split-jobs",
            "name": "Processar cada job",
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                660,
                0
            ]
        },
        {
            "parameters": {
                "operation": "push",
                "list": "image_queue_simple",
                "messageData": "={{ JSON.stringify({ ...JSON.parse($json.job_data), retryAttempt: $json.retry_count + 1 }) }}"
            },
            "id": "redis-requeue",
            "name": "Re-enfileirar no Redis",
            "type": "n8n-nodes-base.redis",
            "typeVersion": 1,
            "position": [
                880,
                0
            ],
            "credentials": {
                "redis": {
                    "id": "CONFIGURE_CREDENTIAL",
                    "name": "Redis"
                }
            }
        },
        {
            "parameters": {
                "method": "PATCH",
                "url": "=https://bpqtzydsxmjazdzzcvno.supabase.co/rest/v1/image_generation_queue?id=eq.{{ $json.id }}",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
                        },
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
                        },
                        {
                            "name": "Prefer",
                            "value": "return=minimal"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"status\": \"pending\",\n  \"retry_count\": {{ $json.retry_count + 1 }},\n  \"error_message\": null,\n  \"locked_at\": null\n}",
                "options": {}
            },
            "id": "update-job-status",
            "name": "Atualizar status no Supabase",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1100,
                0
            ]
        },
        {
            "parameters": {
                "chatId": "5263904952",
                "text": "=🔄 **Job Retry Automático**\n\n🆔 Job: {{ $json.id }}\n🔢 Tentativa: {{ $json.retry_count + 1 }}/3\n📅 {{ $now.format('dd/MM/yyyy HH:mm') }}",
                "additionalFields": {
                    "parse_mode": "Markdown"
                }
            },
            "id": "telegram-retry-alert",
            "name": "Telegram - Notificar Retry",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1.2,
            "position": [
                1320,
                0
            ],
            "credentials": {
                "telegramApi": {
                    "id": "CONFIGURE_CREDENTIAL",
                    "name": "Telegram ElectroHub"
                }
            }
        }
    ],
    "connections": {
        "A cada 10 minutos": {
            "main": [
                [
                    {
                        "node": "Buscar Jobs Falhados",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Buscar Jobs Falhados": {
            "main": [
                [
                    {
                        "node": "Tem jobs para retry?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Tem jobs para retry?": {
            "main": [
                [
                    {
                        "node": "Processar cada job",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Processar cada job": {
            "main": [
                [
                    {
                        "node": "Re-enfileirar no Redis",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Re-enfileirar no Redis": {
            "main": [
                [
                    {
                        "node": "Atualizar status no Supabase",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Atualizar status no Supabase": {
            "main": [
                [
                    {
                        "node": "Telegram - Notificar Retry",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "staticData": null,
    "tags": [],
    "triggerCount": 1,
    "active": false
}